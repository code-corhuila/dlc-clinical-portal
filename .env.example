# Local port for this remote only. The Gateway URL is configured exclusively by dlc-front.
VITE_PORT=4173

# Host port used by Docker Compose.
PORTAL_PORT=4173
# IANA clinic timezone for displayed dates; the same value as the Clinical API CLINIC_TIMEZONE.
VITE_CLINIC_TIMEZONE=America/Bogota
# Session permissions that let an Administrator see clinical content (PAT-003); the same
# values as the Clinical API CLINICAL_READ_PERMISSION and CLINICAL_WRITE_PERMISSION.
VITE_CLINICAL_READ_PERMISSION=clinical:read
VITE_CLINICAL_WRITE_PERMISSION=clinical:write
